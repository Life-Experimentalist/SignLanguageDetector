# Core app config
DEBUG=False
PORT=5000

# Optional overrides
# DATA_DIR=./data
# MODELS_DIR=./models
# LOGS_DIR=./logs

# Quiz settings
QUIZ_DURATION=30
QUIZ_NUM_GUESSES=5
QUIZ_RELOAD_INTERVAL=2000
DEMO_QUIZ_LETTERS=ABCDE

# Telemetry controls (CFlair Counter)
# Uses https://counter.vkrishna04.me by default.
# Set either spelling to true to disable anonymous telemetry ping.
DISABLE_ANONYMOUS_TELEMETRY=false
DISABLE_ANONYMOUS_TELMETRY=false
TELEMETRY_COUNTER_BASE_URL=https://counter.vkrishna04.me
TELEMETRY_PROJECT_NAME=sign-language-detector
